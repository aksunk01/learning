# Additional variables docker-compose.prod.yml needs on top of what the
# original docker-compose.yml already reads from the repo-root .env file
# (POSTGRES_*, MINIO_ROOT_*, REDIS_*). Append these to that same .env -
# Compose auto-loads a file literally named ".env" in the project directory,
# and mixing it with a second --env-file has proven unreliable (some
# variables silently resolve blank on `up`/`down` even though `config` shows
# them fine). One file, no --env-file flag, is the reliable setup.
#
# Usage:
#   docker compose -f docker-compose.prod.yml up -d --build

MINIO_BUCKET=academic-materials

JWT_SECRET_KEY=changeme-generate-a-long-random-value

GOOGLE_API_KEY=
# Optional: comma-separated fallback keys, tried in order when the active
# one's quota is exhausted. See backend/app/services/gemini_client_pool.py.
# Still used for non-RAG features: assignment extraction, grading extraction,
# and planner suggestions.
GOOGLE_API_KEY_FALLBACKS=

# Self-hosted Ollama instance used for the RAG pipeline (both embeddings and
# answer generation). Reached over Tailscale MagicDNS - see
# backend/app/services/embedding.py and backend/app/services/generation.py.
# All three have working defaults, so these only need to be set if your
# Ollama host/models differ.
OLLAMA_BASE_URL=http://ollama-server:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_GENERATION_MODEL=llama3.2:3b
# Model used for task/planning answers ("what should I prioritize") - these
# use a different system prompt and context shape (a structured assignment
# list, not document chunks) than material Q&A, so a different model may
# suit it better. Leave unset to just reuse OLLAMA_GENERATION_MODEL.
OLLAMA_TASK_MODEL=llama3.2:3b

# Optional: single-user login bypass at GET /auth/magic-login?token=...
# Leave both blank to disable the endpoint (it 404s). When set, visiting
# that URL with the matching token logs in ONLY the account named by
# MAGIC_LOGIN_USER_EMAIL - no other account can use it.
# Generate a token with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MAGIC_LOGIN_TOKEN=
MAGIC_LOGIN_USER_EMAIL=

# --- Tailscale ---
# Generate a key at https://login.tailscale.com/admin/settings/keys.
# Mark it "Reusable" (so it can authenticate both containers below, and so you
# can tear down/recreate a container without generating a new key each time)
# and NOT "Ephemeral" (so each device/hostname persists between restarts).
# One reusable key can be used for both - each container still registers as
# its own separate tailnet device, named by TS_HOSTNAME_* below.
TS_AUTHKEY_BACKEND=
TS_AUTHKEY_FRONTEND=

# Whatever you type on the tailnet to reach each service, e.g.
# http://dueboard and http://academic-assistant-api with no port.
TS_HOSTNAME_BACKEND=academic-assistant-api
TS_HOSTNAME_FRONTEND=dueboard
