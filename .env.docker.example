# Additional variables docker-compose.prod.yml needs on top of what the
# original docker-compose.yml already reads from the repo-root .env file
# (POSTGRES_*, MINIO_ROOT_*, REDIS_*). Append these to that same .env -
# Compose auto-loads a file literally named ".env" in the project directory,
# and mixing it with a second --env-file has proven unreliable (some
# variables silently resolve blank on `up`/`down` even though `config` shows
# them fine). One file, no --env-file flag, is the reliable setup.
#
# Usage:
#   docker compose -f docker-compose.prod.yml up -d --build

MINIO_BUCKET=academic-materials

JWT_SECRET_KEY=changeme-generate-a-long-random-value

GOOGLE_API_KEY=
# Optional: comma-separated fallback keys, tried in order when the active
# one's quota is exhausted. See backend/app/services/gemini_client_pool.py.
GOOGLE_API_KEY_FALLBACKS=

# --- Tailscale ---
# Generate a key at https://login.tailscale.com/admin/settings/keys.
# Mark it "Reusable" (so it can authenticate both containers below, and so you
# can tear down/recreate a container without generating a new key each time)
# and NOT "Ephemeral" (so each device/hostname persists between restarts).
# One reusable key can be used for both - each container still registers as
# its own separate tailnet device, named by TS_HOSTNAME_* below.
TS_AUTHKEY_BACKEND=
TS_AUTHKEY_FRONTEND=

# Whatever you type on the tailnet to reach each service, e.g.
# https://academic-assistant and https://academic-assistant-api with no port.
TS_HOSTNAME_BACKEND=academic-assistant-api
TS_HOSTNAME_FRONTEND=academic-assistant
